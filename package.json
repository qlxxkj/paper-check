{
    "name": "paper-check",
    "version": "1.0.0",
    "description": "单机版Word文档批量解析、查重与存储系统",
    "keywords": [
        "paper",
        "check"
    ],
    "homepage": "https://github.com/qlxxkj/paper-check#readme",
    "bugs": {
        "url": "https://github.com/qlxxkj/paper-check/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/qlxxkj/paper-check.git"
    },
    "license": "MIT",
    "author": "hawkli",
    "main": "dist/main.js",
    "scripts": {
        "build": "webpack --config webpack.config.js",
        "start": "electron .",
        "dist": "npm run build && electron-builder",
        "package": "electron-builder",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.5",
        "@types/node": "^20.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/textract": "^2.4.0",
        "electron": "^27.0.0",
        "electron-builder": "^24.6.4",
        "ts-loader": "^9.5.0",
        "typescript": "^5.0.0",
        "webpack": "^5.88.0",
        "webpack-cli": "^5.1.0"
    },
    "dependencies": {
        "better-sqlite3": "^8.0.1",
        "mammoth": "^1.6.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "textract": "^2.5.0"
    },
    "build": {
        "appId": "com.worddedup.app",
        "productName": "Word文档查重系统",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "node_modules/**/*",
            "config/**/*"
        ],
        "win": {
            "target": "portable",
            "icon": "resources/icon.ico"
        },
        "portable": {
            "artifactName": "WordDedup.exe"
        }
    }
}