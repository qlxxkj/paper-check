{
    "name": "paper-check",
    "version": "1.0.0",
    "description": "单机版Word文档批量解析、查重与存储系统",
    "keywords": [
        "paper",
        "check"
    ],
    "homepage": "https://github.com/qlxxkj/paper-check#readme",
    "bugs": {
        "url": "https://github.com/qlxxkj/paper-check/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/qlxxkj/paper-check.git"
    },
    "license": "MIT",
    "author": "hawkli",
    "main": "dist/main.js",
    "scripts": {
        "build": "webpack --config webpack.config.js",
        "start": "electron .",
        "dist": "npm run build && electron-builder  --publish always",
        "package": "electron-builder",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/better-sqlite3": "^7.6.5",
        "@types/diff": "^7.0.2",
        "@types/node": "^20.19.43",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "copy-webpack-plugin": "^14.0.0",
        "electron": "^27.0.0",
        "electron-builder": "^24.13.3",
        "electron-rebuild": "^3.2.9",
        "ts-loader": "^9.5.0",
        "typescript": "^5.0.0",
        "webpack": "^5.88.0",
        "webpack-cli": "^5.1.0"
    },
    "dependencies": {
        "adm-zip": "^0.6.0",
        "better-sqlite3": "^8.0.1",
        "diff": "^9.0.0",
        "electron-updater": "^6.8.9",
        "mammoth": "^1.12.0",
        "pdf-parse": "^2.4.5",
        "react": "^18.2.0",
        "react-dom": "^18.3.1"
    },
    "build": {
        "appId": "com.lushengshuzi.papercheck",
        "productName": "论文查重系统",
        "publish": [
            {
                "provider": "github",
                "private": false
            }
        ],
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "node_modules/**/*",
            "config/**/*",
            "resources/**/*"
        ],
        "extraResources": [
            {
                "from": "resources",
                "to": "resources",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "resources/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true
        }
    }
}
